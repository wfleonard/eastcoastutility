# Mailtrap (transactional email for contact form)
MAILTRAP_API_TOKEN=your_mailtrap_api_token_here
CONTACT_FROM_EMAIL=noreply@eastcoastutility.com
CONTACT_TO_EMAIL=tom@eastcoastutility.com

# Spam defense — only enforced when NODE_ENV=production. Set this to the
# public site origin so the /api/contact route rejects cross-origin POSTs.
ALLOWED_ORIGIN=https://eastcoastutility.com
